# Never commit a real key. Create a fresh OpenRouter key after revoking any exposed key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Comma-separated models tried in order if the primary returns invalid/blocked output.
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_MODE=live
MAX_MODEL_OUTPUT_TOKENS=3500

# PostgreSQL is required for a shared internet deployment. Leave blank for in-memory local demo mode.
DATABASE_URL=postgresql://agentweb:agentweb@localhost:5432/agentweb

API_HOST=0.0.0.0
API_PORT=8787
PUBLIC_API_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8787
LOG_LEVEL=info
